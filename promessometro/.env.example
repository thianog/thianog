# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Conexão com o PostgreSQL (local, ou a External Database URL da Render com ?sslmode=require).
DATABASE_URL=postgres://usuario:senha@localhost:5432/promessometro

# Banco descartável usado pelos testes (npm run test:db). O teste APAGA tudo nele.
TEST_DATABASE_URL=postgres://usuario:senha@localhost:5432/promessometro_teste
